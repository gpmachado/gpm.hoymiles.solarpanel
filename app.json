            "title": {
              "en": "Fault"
            },
            "placeholder": {
              "en": "Type to search..."
            }
          }
        ]
      },
      {
        "id": "has_active_fault",
        "title": {
          "en": "Fault/alarm !{{is|isn't}} active",
          "nl": "Storing/alarm !{{is|is niet}} actief",
          "de": "Störung/Alarm !{{ist|ist nicht}} aktiv",
          "fr": "Défaut/alarme !{{est|n'est pas}} actif",
          "it": "Guasto/allarme !{{è|non è}} attivo",
          "sv": "Fel/larm !{{är|är inte}} aktivt",
          "no": "Feil/alarm !{{er|er ikke}} aktiv",
          "es": "Fallo/alarma !{{está|no está}} activo",
          "da": "Fejl/alarm !{{er|er ikke}} aktiv",
          "pl": "Usterka/alarm !{{jest|nie jest}} aktywna"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=fault_description"
          }
        ]
      },
      {
        "id": "is_solar_producing",
        "title": {
          "en": "Solar production !{{is|is not}} active",
          "nl": "Zonneproductie !{{is|is niet}} actief",
          "de": "Solarproduktion !{{ist|ist nicht}} aktiv",
          "fr": "La production solaire !{{est|n'est pas}} active",
          "it": "La produzione solare !{{è|non è}} attiva",
          "sv": "Solproduktion !{{är|är inte}} aktiv",
          "no": "Solproduksjon !{{er|er ikke}} aktiv",
          "es": "La producción solar !{{está|no está}} activa",
          "da": "Solproduktion !{{er|er ikke}} aktiv",
          "pl": "Produkcja solarna !{{jest|nie jest}} aktywna"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=meter_power.today"
          }
        ]
      }
    ]
  },
