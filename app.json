  "flow": {
    "triggers": [
      {
        "id": "daily_data_updated",
        "title": {
          "en": "Daily data updated",
          "nl": "Dagelijkse gegevens bijgewerkt",
          "de": "Tägliche Daten aktualisiert",
          "fr": "Données journalières mises à jour",
          "it": "Dati giornalieri aggiornati",
          "sv": "Daglig data uppdaterad",
          "no": "Daglige data oppdatert",
          "es": "Datos diarios actualizados",
          "da": "Daglige data opdateret",
          "pl": "Dzienne dane zaktualizowane"
        },
        "hint": {
          "en": "Triggered once per day when the inverter stops producing (at sunset). Use the token to read today's total energy production."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=meter_power.today"
          }
        ],
        "tokens": [
          {
            "name": "daily_production",
            "type": "number",
            "title": {
              "en": "Daily Production (kWh)"
            }
          }
        ]
      },
      {
        "id": "data_updated",
        "title": {
          "en": "Inverter data updated",
          "nl": "Omvormergegevens bijgewerkt",
          "de": "Wechselrichterdaten aktualisiert",
          "fr": "Données de l'onduleur mises à jour",
          "it": "Dati inverter aggiornati",
          "sv": "Växelriktardata uppdaterad",
          "no": "Vekselretter-data oppdatert",
          "es": "Datos del inversor actualizados",
          "da": "Inverterdata opdateret",
          "pl": "Dane falownika zaktualizowane"
        },
        "hint": {
          "en": "Triggered on every successful poll (every 60 s by default). Use tokens to read current power and today's accumulated energy."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=meter_power.today"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          },
          {
            "name": "daily_production",
            "type": "number",
            "title": {
              "en": "Daily Production (kWh)"
            }
          }
        ]
      },
      {
        "id": "fault_detected",
        "title": {
          "en": "Fault/alarm detected",
          "nl": "Storing/alarm gedetecteerd",
          "de": "Störung/Alarm erkannt",
          "fr": "Défaut/alarme détecté",
          "it": "Guasto/allarme rilevato",
          "sv": "Fel/larm upptäckt",
          "no": "Feil/alarm oppdaget",
          "es": "Fallo/alarma detectado",
          "da": "Fejl/alarm registreret",
          "pl": "Wykryto usterkę/alarm"
        },
        "hint": {
          "en": "Triggered when the microinverter transitions from OK into a fault/alarm state (fires once per new fault, not on every poll while it persists)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=fault_description"
          }
        ],
        "tokens": [
          {
            "name": "description",
            "type": "string",
            "title": {
              "en": "Fault Description"
            }
          }
        ]
      },
      {
        "id": "solar_production_started",
        "title": {
          "en": "Solar production started",
          "nl": "Zonneproductie gestart",
          "de": "Solarproduktion gestartet",
          "fr": "Production solaire démarrée",
          "it": "Produzione solare avviata",
          "sv": "Solproduktion startad",
          "no": "Solproduksjon startet",
          "es": "Producción solar iniciada",
          "da": "Solproduktion startet",
          "pl": "Produkcja solarna rozpoczęta"
        },
        "hint": {
          "en": "Triggered when the inverter starts producing power (e.g. at sunrise)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=meter_power.today"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          }
        ]
      },
      {
        "id": "solar_production_stopped",
        "title": {
          "en": "Solar production stopped",
          "nl": "Zonneproductie gestopt",
          "de": "Solarproduktion gestoppt",
          "fr": "Production solaire arrêtée",
          "it": "Produzione solare fermata",
          "sv": "Solproduktion stoppad",
          "no": "Solproduksjon stoppet",
          "es": "Producción solar detenida",
          "da": "Solproduktion stoppet",
          "pl": "Produkcja solarna zatrzymana"
        },
        "hint": {
          "en": "Triggered when the inverter stops producing power (e.g. at sunset or on a fault)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=meter_power.today"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "fault_is",
        "title": {
          "en": "Fault !{{is|isn't}} ...",
          "nl": "Storing !{{is|is niet}} ...",
          "de": "Störung !{{ist|ist nicht}} ...",
          "fr": "Défaut !{{est|n'est pas}} ...",
          "it": "Guasto !{{è|non è}} ...",
          "sv": "Fel !{{är|är inte}} ...",
          "no": "Feil !{{er|er ikke}} ...",
          "es": "Fallo !{{es|no es}} ...",
          "da": "Fejl !{{er|er ikke}} ...",
          "pl": "Usterka !{{jest|nie jest}} ..."
        },
        "titleFormatted": {
          "en": "Fault !{{is|isn't}} [[fault]]"
        },
        "hint": {
          "en": "Checks whether a specific fault/alarm is currently active. The suggestion list is filtered to what's possible on the selected device (battery-specific codes are hidden unless the device is set as a hybrid inverter in its settings)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles&capabilities=fault_description"
          },
          {
